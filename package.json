{
  "name": "insightflow-data-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ensure:montane": "node scripts/ensure-montane.mjs",
    "predev": "npm run ensure:montane",
    "dev": "concurrently -k -n api,web -c blue,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "prebuild": "npm run ensure:montane",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.json && vite build",
    "prestart": "npm run ensure:montane",
    "start": "node dist/server/server/index.js",
    "pretest": "npm run ensure:montane",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "echarts": "^6.0.0",
    "fastify": "^5.6.1",
    "montane-code": "git+https://github.com/kissionz/data-engineer.git#542c59b",
    "mysql2": "^3.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
